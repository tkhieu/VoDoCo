# Local development; set actual production values in provider Secrets/Publishing.
# This file is not loaded automatically. Never put the Pod account API key here.
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
INFERENCE_BASE_URL=http://127.0.0.1:8000
# Generate an independent >=32-byte ASCII service token and use it on both servers.
INFERENCE_SERVICE_TOKEN=

# Pod defaults. For a local run, use the prepared release and checked manifest paths.
VODOCO_MODEL_ROOT=/opt/vodoco/models
VODOCO_MODEL_MANIFEST=/opt/vodoco/model-manifest.json
VODOCO_TEMP_DIR=/tmp/vodoco-inference

# Owner approved this research sample on 2026-09-18. Relative paths are repo-relative.
DEMO_SAMPLE_APPROVED=1
DEMO_SAMPLE_PATH=giai_doan_14_hoan_thien/audio.wav
DEMO_SAMPLE_PROVENANCE="Audio nghiên cứu được chủ sở hữu cho phép dùng trong demo có mật khẩu, 2026-09-18."
# Replit's shared demo password belongs only in Publishing access settings.
